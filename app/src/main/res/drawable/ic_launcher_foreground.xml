<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：位图铺满 108dp 画布，再用 20% 的内缩收到 60% 有效区
  （64.8dp）—— 这是 comicApp 的做法（它的 ic_launcher_foreground.xml 同样
  是 `<inset android:inset="20%" />`），两张图标在桌面上看起来一样大。
  位图取「长边贴边」，所以角色的高度正好占满，宽度按原图比例留白。
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_foreground"
    android:inset="20%" />
