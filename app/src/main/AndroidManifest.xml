<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      后台持续播放：媒体类型的前台服务。
      Android 14 起光有 FOREGROUND_SERVICE 不够，还必须声明具体类型对应的权限，
      否则 startForeground 会抛 SecurityException。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      悬浮窗歌词：需要「显示在其他应用上层」。这是特殊权限，不是运行时权限，
      清单里声明后还要用户去系统设置手动打开（见 LyricsOverlay.canDraw）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      下载到公共目录（/storage/emulated/0/ToAsmr）：需要「所有文件访问权限」。
      Android 11 起这是特殊权限，靠 Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION 申请；
      Android 10 及以下没有这个限制，走旧的写外置存储权限（限定 29 以免在 11+ 上被当成敏感权限提示）。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:name=".AsmrOneApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AsmrOne">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AsmrOne"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              外部链接直达作品详情：在别的 App 里点
              https://asmr.one/work/RJ01700554 就跳进本 App 的这一部作品。

              `autoVerify` 会去读 https://asmr.one/.well-known/assetlinks.json：
              站点有这个文件、且声明了本 App 的签名指纹，系统才会把这类链接
              默认交给本 App；没有的话系统仍会把它列进「用哪个应用打开」的候选里
              （用户选一次并「始终」之后也生效）。所以这条是可选的加分项，不是前提。

              多个 <data> 的属性是**合并**的：scheme=https + 这几个 host + /work/ 前缀。
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="asmr.one" />
                <data android:host="www.asmr.one" />
                <data android:host="beta.asmr.one" />
                <data android:pathPrefix="/work/" />
            </intent-filter>

            <!--
              本站自己的 scheme：toasmr://work/RJ01700554
              （给别的 App / 自己的分享功能用，不依赖域名校验）
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="work"
                    android:scheme="toasmr" />
            </intent-filter>
        </activity>

        <!--
          播放控制服务：MediaSession（锁屏 / 系统媒体卡片 / 耳机与蓝牙线控）
          + 媒体通知 + 前台服务态。

          `exported=false` 是对的：它的入口只有本 App 发的 PendingIntent（通知上的
          三个按钮）与系统投递的媒体按键 —— 都不需要对外暴露。
        -->
        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          文件树里 PDF 的「交给外部阅读器打开」通道。

          Android 7 起禁止把 file:// URI 交给别的 App（FileUriExposedException），
          所以下载到缓存后必须经 FileProvider 换成可授权的 content:// URI。
          可共享范围见 res/xml/file_paths.xml（只暴露 cache/external_open/）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
